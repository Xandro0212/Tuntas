# Opsional — gunakan LLM sungguhan untuk menyusun rencana.
# Tanpa ini, aplikasi memakai planner lokal (demo) yang tetap berjalan.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Ganti di produksi agar cookie sesi tidak memakai secret default.
# AUTH_SECRET=ganti-dengan-string-acak-panjang

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (opsional). Webhook: /api/whatsapp/webhook
# ---------------------------------------------------------------------------
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=ganti-token-verifikasi
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v23.0

# ---------------------------------------------------------------------------
# Supabase — wajib untuk penyimpanan persisten di Vercel.
# Jalankan supabase/schema.sql sekali di SQL Editor Supabase.
# Gunakan service role key (bukan anon key) agar server bisa menulis data.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Opsional, kalau nama tabel ingin diganti:
# SUPABASE_STATE_TABLE=tuntas_state
